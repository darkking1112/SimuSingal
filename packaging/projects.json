{
  "analysis": {
    "package": "signal_analysis",
    "app_dir": "analysis_desktop",
    "executable": "SignalAnalysis",
    "exclude": ["communication_sim", "simpy", "torch", "torchvision", "ultralytics", "torchsig"],
    "collect_all": ["sigmf", "jsonschema_specifications"],
    "collect_data": ["signal_analysis"]
  },
  "simulation": {
    "package": "communication_sim",
    "app_dir": "simulation_desktop",
    "executable": "CommunicationSim",
    "exclude": ["signal_analysis"]
  }
}
